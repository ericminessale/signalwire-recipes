# Dashboard > Tools > Click to Call > create a token. Public by design. Required.
CLICK_TO_CALL_TOKEN=c2c_your_token_here

# The Fabric address the button dials, and the button's text.
DESTINATION=/public/support
LABEL=Talk to the workshop

# Only for the optional REST exchange in exchange(); the page itself needs none of these.
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here

# Local port for the Flask app.
PORT=8080
